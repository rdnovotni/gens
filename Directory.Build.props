<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Historical: while Unity was still a supported client, Gens.Simulation/Gens.Application/
       Gens.Presentation were also imported into the Unity project as local file-path packages
       (Packages/manifest.json pointed straight at their src/ folders), and Unity's package
       resolver scanned that exact folder — so a normal dotnet build/test leaving bin/obj inside
       it produced duplicate generated assembly attributes and a CS1704 duplicate assembly import
       once Unity also compiled the same sources via its asmdef. Unity has since been retired, but
       the redirect is kept for general build-output hygiene (keeps src/ free of bin/obj). -->
  <PropertyGroup Condition="'$(MSBuildProjectName)'=='Gens.Simulation' OR '$(MSBuildProjectName)'=='Gens.Application' OR '$(MSBuildProjectName)'=='Gens.Presentation'">
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts/dotnet-build/$(MSBuildProjectName)/obj/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts/dotnet-build/$(MSBuildProjectName)/bin/</BaseOutputPath>
  </PropertyGroup>
</Project>
