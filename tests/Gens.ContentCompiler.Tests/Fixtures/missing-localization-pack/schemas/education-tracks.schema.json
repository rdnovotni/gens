{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gens.invalid/schemas/education-tracks.schema.json",
  "$defs": {
    "coreAttribute": {
      "type": "string",
      "enum": [
        "diplomacy",
        "martial",
        "stewardship",
        "intrigue",
        "learning"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "https://gens.invalid/schemas/_envelope.schema.json#/$defs/envelope"
    },
    {
      "type": "object",
      "required": [
        "deliveringBuildings",
        "primaryAttribute",
        "monthlyAttributeGain",
        "completionMonths",
        "distinguishedTierCostPerMonth",
        "distinguishedTierMultiplier"
      ],
      "properties": {
        "deliveringBuildings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "primaryAttribute": {
          "$ref": "#/$defs/coreAttribute"
        },
        "secondaryAttribute": {
          "$ref": "#/$defs/coreAttribute"
        },
        "monthlyAttributeGain": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "completionMonths": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "distinguishedTierCostPerMonth": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "distinguishedTierMultiplier": {
          "type": "integer",
          "exclusiveMinimum": 1
        },
        "grantsCulturalPrestige": {
          "type": "boolean"
        },
        "monthlyPrestigeGain": {
          "type": "integer",
          "minimum": 0
        },
        "satisfiesMagistracyContestGate": {
          "type": "boolean"
        }
      }
    }
  ]
}
