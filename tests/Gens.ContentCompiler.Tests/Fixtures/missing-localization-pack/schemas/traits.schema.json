{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gens.invalid/schemas/traits.schema.json",
  "allOf": [
    {
      "$ref": "https://gens.invalid/schemas/_envelope.schema.json#/$defs/envelope"
    },
    {
      "type": "object",
      "required": [
        "category"
      ],
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "congenital",
            "formative",
            "reactive",
            "lifestyle"
          ]
        },
        "axis": {
          "type": "string",
          "enum": [
            "honor",
            "compassion",
            "greed",
            "zealotry",
            "vengefulness",
            "boldness",
            "rationality"
          ]
        },
        "axisNudge": {
          "type": "integer",
          "minimum": -25,
          "maximum": 25,
          "not": {
            "const": 0
          }
        },
        "opposes": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "spectrum": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "tierPosition": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      },
      "dependentRequired": {
        "axis": [
          "axisNudge"
        ],
        "axisNudge": [
          "axis"
        ],
        "spectrum": [
          "tierPosition"
        ],
        "tierPosition": [
          "spectrum"
        ]
      },
      "not": {
        "required": [
          "opposes",
          "spectrum"
        ]
      }
    }
  ]
}
