{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gens.invalid/schemas/events.schema.json",
  "allOf": [
    {
      "$ref": "https://gens.invalid/schemas/_envelope.schema.json#/$defs/envelope"
    },
    {
      "type": "object",
      "required": [
        "weight",
        "chain"
      ],
      "properties": {
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "chain": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      }
    }
  ]
}
