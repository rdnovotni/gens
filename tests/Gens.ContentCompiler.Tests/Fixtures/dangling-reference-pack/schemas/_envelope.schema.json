{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gens.invalid/schemas/_envelope.schema.json",
  "$defs": {
    "envelope": {
      "type": "object",
      "required": ["id", "status", "nameKey"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "status": { "type": "string", "enum": ["active", "superseded"] },
        "supersededBy": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "nameKey": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)*$" },
        "descriptionKey": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)*$" }
      },
      "if": {
        "properties": { "status": { "const": "superseded" } },
        "required": ["status"]
      },
      "then": {
        "required": ["supersededBy"]
      }
    }
  }
}
