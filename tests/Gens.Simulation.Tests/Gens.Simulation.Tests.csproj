<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- CA1861 (prefer static readonly fields over inline array literals) is a hot-path
         performance rule; test methods run once per test and read better with the expected
         value inlined at the assertion instead of hoisted to a field used from one place. -->
    <NoWarn>$(NoWarn);CA1861</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FsCheck.NUnit" Version="3.3.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Gens.Simulation/Gens.Simulation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Saves/Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

