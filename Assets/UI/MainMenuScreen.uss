@import url("Palette.uss");
@import url("WaxSeal.uss");

.main-menu-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: #2A231B;
    justify-content: center;
    align-items: center;
}

.main-menu-card {
    width: 480px;
    background-color: #E9DFC4;
    border-width: 3px;
    border-color: #B9922E;
    border-radius: 4px;
    padding: 36px 32px;
    align-items: center;
    scale: 0.96 0.96;
    opacity: 0;
    transition-property: scale, opacity;
    transition-duration: 220ms;
    transition-timing-function: ease-out;
}

.main-menu-card--visible {
    scale: 1 1;
    opacity: 1;
}

.main-menu-seal {
    margin-bottom: 12px;
}

.main-menu-title {
    font-size: 44px;
    color: #2A231B;
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 4px;
}

.main-menu-subtitle {
    font-size: 13px;
    color: #5C3350;
    -unity-font-style: italic;
    margin-bottom: 20px;
}

.main-menu-divider {
    width: 100%;
    height: 2px;
    background-color: #B9922E;
    margin-bottom: 24px;
}

.main-menu-buttons {
    width: 100%;
    align-items: center;
}

.main-menu-button {
    width: 100%;
    height: 42px;
    margin-bottom: 12px;
    background-color: #2A231B;
    color: #E9DFC4;
    font-size: 14px;
    -unity-font-style: bold;
    border-width: 1px;
    border-color: #B9922E;
    border-radius: 3px;
    justify-content: center;
    align-items: center;
}

.main-menu-button:hover {
    background-color: #3D3328;
    border-color: #E9DFC4;
}

.main-menu-button:active {
    scale: 0.97 0.97;
    background-color: #201A14;
}

.main-menu-button:disabled {
    background-color: #4A423B;
    color: #8C8276;
    border-color: #6E8272;
    opacity: 0.6;
}

.main-menu-button--primary {
    background-color: #5C3350;
    border-color: #B9922E;
}

.main-menu-button--primary:hover {
    background-color: #723E63;
}

.main-menu-button--primary:active {
    background-color: #4A2842;
}

.main-menu-status {
    font-size: 12px;
    color: #7A2E1F;
    margin-top: 8px;
    min-height: 16px;
}

.main-menu-version {
    font-size: 11px;
    color: #6E8272;
    margin-top: 16px;
}
