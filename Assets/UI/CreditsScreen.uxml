<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="CreditsScreen.uss" />
    <ui:VisualElement name="credits-screen" class="credits-root">
        <ui:VisualElement class="credits-card">
            <ui:Label text="GENS" class="credits-title" />
            <ui:Label text="A Dynastic Simulation of Ancient Rome" class="credits-subtitle" />
            <ui:VisualElement class="credits-divider" />

            <ui:Label text="Design &amp; Development" class="credits-section-label" />
            <ui:Label text="The Gens Project" class="credits-line" />

            <ui:Label text="Built With" class="credits-section-label" />
            <ui:Label text="Unity 6.3 LTS &#183; UI Toolkit" class="credits-line" />

            <ui:VisualElement class="credits-divider" />
            <ui:Button name="credits-back-button" text="Back" class="credits-action-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
