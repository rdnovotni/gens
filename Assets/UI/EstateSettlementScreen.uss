@import url("Diptych.uss");

.estate-holding {
    background-color: rgba(233, 223, 196, 0.4);
    border-width: 1px;
    border-color: #9C4B2E;
    border-radius: 2px;
    padding: 8px 10px;
    margin-bottom: 8px;
}

.estate-holding__label {
    color: #9C4B2E;
    -unity-font-style: bold;
    font-size: 14px;
    margin-bottom: 4px;
}

.estate-holding__buildings {
    flex-direction: column;
}

.estate-building-row {
    color: #2A231B;
    font-size: 12px;
    margin-left: 8px;
}

.estate-action-button {
    font-size: 12px;
    padding: 6px 10px;
    margin-bottom: 8px;
    background-color: rgba(92, 51, 80, 0.12);
    color: #5C3350;
    border-width: 1px;
    border-color: #5C3350;
    border-radius: 2px;
}
