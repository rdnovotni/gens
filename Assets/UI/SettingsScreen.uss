@import url("Palette.uss");

.settings-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: #2A231B;
    justify-content: center;
    align-items: center;
}

.settings-card {
    width: 480px;
    background-color: #E9DFC4;
    border-width: 3px;
    border-color: #B9922E;
    border-radius: 4px;
    padding: 32px;
}

.settings-title {
    font-size: 28px;
    color: #2A231B;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 4px;
    -unity-text-align: middle-center;
}

.settings-divider {
    width: 100%;
    height: 2px;
    background-color: #B9922E;
    margin-bottom: 16px;
    margin-top: 4px;
}

.settings-section {
    margin-bottom: 16px;
}

.settings-section-label {
    font-size: 12px;
    color: #5C3350;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 8px;
}

.settings-slider {
    margin-left: 0;
    margin-right: 0;
}

.settings-action-button {
    height: 40px;
    margin-top: 4px;
    background-color: #2A231B;
    color: #E9DFC4;
    font-size: 13px;
    -unity-font-style: bold;
    border-width: 1px;
    border-color: #B9922E;
    border-radius: 3px;
}

.settings-action-button:hover {
    background-color: #3D3328;
}
