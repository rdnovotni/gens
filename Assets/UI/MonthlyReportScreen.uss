@import url("Diptych.uss");

.monthly-report-summary {
    flex-direction: row;
    margin-bottom: 12px;
}

.monthly-report-summary__stat {
    color: #2A231B;
    font-size: 13px;
    margin-right: 20px;
}

.monthly-report-headline {
    color: #2A231B;
    font-size: 12px;
    background-color: rgba(233, 223, 196, 0.4);
    border-left-width: 3px;
    border-left-color: #B9922E;
    padding: 4px 8px;
    margin-bottom: 4px;
}
