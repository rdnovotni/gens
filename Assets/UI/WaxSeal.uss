@import url("Palette.uss");

/*
 * The signature wax-seal press control (gens-core-design.md §7.6): "a circular seal-press motif that
 * visually 'sets' when pressed, rather than a generic button." Shared by the wax-seal confirmation
 * dialog and the ink bar's month-advance control (§7.7: "the wax seal pressing down... so time's
 * passage always registers physically").
 */

.wax-seal {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    background-color: #B9922E;
    border-width: 3px;
    border-color: #7A2E1F;
    align-items: center;
    justify-content: center;
    transition-property: scale;
    transition-duration: 120ms;
}

.wax-seal--pressed {
    scale: 0.85 0.85;
}

.wax-seal__glyph {
    color: #2A231B;
    font-size: 20px;
    -unity-font-style: bold;
}
