.dev-console-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 45%;
    flex-direction: column;
    background-color: rgba(10, 10, 12, 0.88);
    border-bottom-width: 2px;
    border-bottom-color: #4C9A6E;
    padding: 8px;
}

.dev-console-scrollback {
    flex-grow: 1;
    margin-bottom: 6px;
}

.dev-console-scrollback Label {
    color: #C8F5D8;
    font-size: 12px;
    white-space: normal;
    -unity-font-style: normal;
}

.dev-console-input-row {
    flex-direction: row;
    align-items: center;
}

.dev-console-prompt {
    color: #4C9A6E;
    font-size: 14px;
    margin-right: 4px;
    -unity-font-style: bold;
}

.dev-console-input {
    flex-grow: 1;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1px;
    border-color: #4C9A6E;
    color: #E9F7EE;
    font-size: 13px;
}

.dev-console-input > .unity-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: #E9F7EE;
}
