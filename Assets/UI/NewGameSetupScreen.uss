@import url("MainMenuScreen.uss");

.setup-tablet {
    min-width: 360px;
}

.setup-field {
    width: 100%;
    margin-top: 12px;
    align-items: flex-start;
}

.setup-field__label {
    color: #6E8272;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.setup-field__control {
    width: 100%;
}

.setup-field__row {
    flex-direction: row;
    width: 100%;
}

.setup-field__control--seed {
    flex-grow: 1;
}

.setup-field__random {
    width: auto;
    margin-top: 0;
    margin-left: 8px;
}

.setup-actions {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
    margin-top: 24px;
}

.setup-actions .menu-button {
    width: 48%;
    margin-top: 0;
}
